# ==============================================================================
# VisaReThink Environment Configuration
# ==============================================================================
# Copy this file to `.env` or `.env.local` to enable live AI capabilities.
#
# NOTE: If no API key is provided, the application runs seamlessly in 
# 100% offline simulated mode with all catalog tools and heuristics enabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Google Gemini (Default & Recommended)
# ------------------------------------------------------------------------------
# Get your free Gemini API key from: https://aistudio.google.com/
VITE_AI_PROVIDER=google
VITE_AI_MODEL=gemini-1.5-flash
VITE_GEMINI_API_KEY=your_google_gemini_api_key_here

# ------------------------------------------------------------------------------
# OPTION 2: OpenAI
# ------------------------------------------------------------------------------
# Get your OpenAI API key from: https://platform.openai.com/api-keys
# To use OpenAI, set VITE_AI_PROVIDER=openai and supply your key:
# VITE_AI_PROVIDER=openai
# VITE_AI_MODEL=gpt-4o-mini
# VITE_OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# OPTION 3: Offline / Simulated Mode (No Key Required)
# ------------------------------------------------------------------------------
# VITE_AI_PROVIDER=mock
