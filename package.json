{
  "name": "horizon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:fonts": "node scripts/check-font-budget.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/noto-sans": "~5.3.0",
    "@fontsource/noto-sans-devanagari": "~5.3.0",
    "@fontsource/noto-sans-kannada": "~5.3.0",
    "@fontsource/noto-sans-tamil": "~5.3.0",
    "@fontsource/noto-sans-telugu": "~5.3.0",
    "@tailwindcss/vite": "~4.3.3",
    "@xstate/react": "~6.1.0",
    "canvas-confetti": "^1.9.4",
    "gsap": "^3.15.0",
    "i18next": "~26.4.0",
    "i18next-browser-languagedetector": "~8.2.1",
    "idb-keyval": "~6.3.0",
    "lucide-react": "~1.34.0",
    "qrcode": "^1.5.4",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-i18next": "~17.0.12",
    "tailwindcss": "~4.3.3",
    "xstate": "~5.32.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "~1.62.1",
    "@testing-library/jest-dom": "~7.0.1",
    "@testing-library/react": "~16.3.2",
    "@testing-library/user-event": "~14.6.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "~6.1.0",
    "eslint": "~10.9.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-jsx-a11y": "~6.10.2",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "^16.0.0",
    "husky": "~9.1.7",
    "jsdom": "~30.0.1",
    "lint-staged": "~17.3.0",
    "prettier": "~3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "~8.68.0",
    "vite": "~8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.1.11",
    "vitest-axe": "~0.1.0",
    "workbox-window": "^7.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "prettier": {
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100
  }
}
